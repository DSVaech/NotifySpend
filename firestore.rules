rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer y escribir sus propios datos.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /gastos/{gastoId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.monto is number
          && request.resource.data.monto > 0
          && request.resource.data.categoria in ['comida', 'transporte', 'compras', 'ocio']
          && request.resource.data.fecha is timestamp;
      }
    }
  }
}
